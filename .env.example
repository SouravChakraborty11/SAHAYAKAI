# ==========================================
# SAHAYAK AI PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# Application
PROJECT_NAME="SAHAYAK AI API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
USE_POSTGRES=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sahayak

# Security & JWT
SECRET_KEY=YOUR_SUPER_SECRET_PRODUCTION_KEY_REPLACE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# AI Provider Keys
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Google Cloud Storage (GCS)
GCS_BUCKET_NAME=sahayak-app-storage
GCS_CREDENTIALS_FILE=/app/gcs_credentials.json

# Qdrant Vector Store
QDRANT_HOST=localhost
QDRANT_PORT=6333
